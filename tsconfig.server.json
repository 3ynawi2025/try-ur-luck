{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src/server",
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": false
  },
  "include": [
    "src/server/**/*.ts"
  ],
  "exclude": [
    "src/app",
    "src/components",
    "src/server/game/__tests__",
    "node_modules"
  ]
}
