# Client (Expo) — تبدأ بـ EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_URL=https://your-render-service.onrender.com
EXPO_PUBLIC_AGORA_APP_ID=your-agora-app-id

# Server (Render) — مطلوبة الآن إلزاميًا (لا قيم مضمّنة في الكود)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-certificate
NODE_ENV=development
PORT=3000

# اختياري: أصول CORS المسموحة مفصولة بفواصل (الويب فقط — الجوال لا يرسل Origin)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
